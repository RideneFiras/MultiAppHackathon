flowchart TD
    customer["Customer message"] --> filter{"Injection filter"}
    filter -- "attack" --> refusal["Polite, fixed refusal<br/>(the AI never sees it)"]
    filter -- "safe" --> agent["Orchestrator agent<br/>gpt-4.1-mini, reply is checked before sending"]
    agent --> inventory["check_inventory"]
    agent --> capture["capture_order"]
    agent --> kb["answer_from_kb"]
    inventory -- "available / not confirmed" --> sheets[("Google Sheets")]
    capture -- "reserve units" --> sheets
    capture -- "new order" --> notion[("Notion")]
    kb -- "store policies" --> supabase[("Supabase")]
    classDef guard fill:#fde8e6,stroke:#b42318,color:#7a1c14
    classDef agentc fill:#efe9fb,stroke:#6d4fc2,color:#3b2a74
    classDef tool fill:#e7eef6,stroke:#1f3a5f,color:#1f3a5f
    classDef app fill:#e6f4ea,stroke:#188038,color:#0d5323
    classDef plain fill:#ffffff,stroke:#9aa0a6,color:#202124
    class customer plain
    class filter,refusal guard
    class agent agentc
    class inventory,capture,kb tool
    class sheets,notion,supabase app
