# Copy to .env and fill in. Keys are read case-insensitively by scripts/lh.py.

# OpenAI (used by scripts/ingest_kb.py; n8n uses its own OpenAI credential)
openai=

# n8n
N8N_BASE_URL=
n8n_api=

# Notion internal integration (the Loomhaus Store page must be shared with it)
NOTION_TOKEN=

# Supabase app project
supabase_url=
supabase_anon=
service_role_supa=
supabase_db_url=

# Written by the setup scripts
NOTION_ORDERS_DB_ID=
GOOGLE_SHEET_ID=
N8N_CRED_NOTION=
N8N_CRED_SUPABASE=
N8N_CRED_ADMIN=
N8N_CRED_CHAT=
LH_ADMIN_TOKEN=
LH_CHAT_TOKEN=
